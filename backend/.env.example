# Copy this file to `backend/.env` and fill in real values.
# Not read automatically by Spring Boot — required only when running the backend
# directly (e.g. via IntelliJ) instead of through Docker Compose.
# In IntelliJ: install the "EnvFile" plugin, then enable it on the Spring Boot
# run configuration and point it at this file (see README / analysis doc for details).

# spring.datasource.password
DB_PASSWORD=changeme

# spring.rabbitmq.password
RABBITMQ_PASSWORD=changeme

# flashsale.jwt.secret — HMAC signing key for JWT access/refresh tokens
JWT_SECRET=changeme
