# Copy this file to `.env` (same directory) and fill in real values.
# Used by `docker compose up -d` and `docker compose -f docker-compose.app.yml up -d`.
# Never commit the real `.env` file.

# MySQL root password (docker-compose.yml) / Spring datasource password (docker-compose.app.yml)
DB_PASSWORD=changeme

# RabbitMQ default user password (docker-compose.yml) / Spring RabbitMQ password (docker-compose.app.yml)
RABBITMQ_PASSWORD=changeme

# HMAC signing key for JWT access/refresh tokens (docker-compose.app.yml)
JWT_SECRET=changeme
